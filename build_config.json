{
  "godot": {
    "path": "/home/buckdi/bin/godot",
    "version": "4.6"
  },
  "build": {
    "project_name": "MiniShooterGame",
    "version_suffix": "dev",
    "export_root": ".exports",
    "output_filename": "{project}_{date}_{os}_{type}",
    "use_separators": true
  },
  "profiles": [
    {
      "name": "Windows",
      "type": "export-debug",
      "platform": "x86_64"
    },
    {
      "name": "Linux",
      "type": "export-release",
      "platform": "x86_64"
    },
    {
      "name": "Web",
      "type": "export-debug",
      "platform": "web"
    }
  ]
}
